<svg width="400" height="400" viewBox="0 0 400 400" xmlns="http://www.w3.org/2000/svg">
    <defs>
        <linearGradient id="profileGrad" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" style="stop-color:#FF9900;stop-opacity:1" />
            <stop offset="100%" style="stop-color:#00E676;stop-opacity:1" />
        </linearGradient>
    </defs>
    <circle cx="200" cy="200" r="180" fill="url(#profileGrad)" />
    <circle cx="200" cy="200" r="150" fill="#0D0D0D" />
    <text x="200" y="180" font-family="'Inter', sans-serif" font-size="48" fill="#FF9900" text-anchor="middle" font-weight="600">A</text>
    <text x="200" y="230" font-family="'Inter', sans-serif" font-size="24" fill="#00E676" text-anchor="middle">Amazon SDE</text>
    <text x="200" y="260" font-family="'Inter', sans-serif" font-size="16" fill="#E0E0E0" text-anchor="middle">Software Development Engineer</text>
    <g transform="translate(200, 300)">
        <circle cx="-40" cy="-20" r="12" fill="#FF9900" opacity="0.7"/>
        <circle cx="0" cy="-20" r="12" fill="#00E676" opacity="0.7"/>
        <circle cx="40" cy="-20" r="12" fill="#FF9900" opacity="0.7"/>
    </g>
</svg>