<svg width="400" height="300" viewBox="0 0 400 300" xmlns="http://www.w3.org/2000/svg">
    <defs>
        <linearGradient id="proj2Grad" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" style="stop-color:#00E676;stop-opacity:0.8" />
            <stop offset="100%" style="stop-color:#FF9900;stop-opacity:0.8" />
        </linearGradient>
    </defs>
    <rect width="400" height="300" fill="url(#proj2Grad)" />
    <rect x="20" y="20" width="360" height="260" fill="#0D0D0D" opacity="0.9" rx="8" ry="8"/>
    <text x="200" y="110" font-family="'Inter', sans-serif" font-size="20" fill="#00E676" text-anchor="middle" font-weight="600">Real-time</text>
    <text x="200" y="140" font-family="'Inter', sans-serif" font-size="20" fill="#FF9900" text-anchor="middle" font-weight="600">Analytics</text>
    <text x="200" y="170" font-family="'Inter', sans-serif" font-size="20" fill="#00E676" text-anchor="middle" font-weight="600">Dashboard</text>
    <text x="200" y="200" font-family="'Inter', sans-serif" font-size="16" fill="#E0E0E0" text-anchor="middle">Processing 1M+ Events/Sec</text>
    <text x="200" y="230" font-family="'Inter', sans-serif" font-size="14" fill="#B0B0B0" text-anchor="middle"><100ms Latency • 99.95% Accuracy</text>
    <g transform="translate(200, 260)">
        <rect x="-30" y="-10" width="60" height="20" fill="#00E676" opacity="0.2" rx="4"/>
        <text x="0" y="5" font-family="'Inter', sans-serif" font-size="12" fill="#00E676" text-anchor="middle">View Demo</text>
    </g>
    <!-- Sample chart elements -->
    <g transform="translate(100, 220)">
        <rect x="0" y="0" width="20" height="30" fill="#FF9900" opacity="0.7"/>
        <rect x="30" y="0" width="20" height="50" fill="#00E676" opacity="0.7"/>
        <rect x="60" y="0" width="20" height="40" fill="#FF9900" opacity="0.7"/>
        <rect x="90" y="0" width="20" height="60" fill="#00E676" opacity="0.7"/>
        <rect x="120" y="0" width="20" height="35" fill="#FF9900" opacity="0.7"/>
        <rect x="150" y="0" width="20" height="45" fill="#00E676" opacity="0.7"/>
    </g>
</svg>