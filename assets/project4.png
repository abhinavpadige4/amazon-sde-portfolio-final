<svg width="400" height="300" viewBox="0 0 400 300" xmlns="http://www.w3.org/2000/svg">
    <defs>
        <linearGradient id="proj4Grad" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" style="stop-color:#00E676;stop-opacity:0.8" />
            <stop offset="100%" style="stop-color:#FF9900;stop-opacity:0.8" />
        </linearGradient>
    </defs>
    <rect width="400" height="300" fill="url(#proj4Grad)" />
    <rect x="20" y="20" width="360" height="260" fill="#0D0D0D" opacity="0.9" rx="8" ry="8"/>
    <text x="200" y="110" font-family="'Inter', sans-serif" font-size="20" fill="#00E676" text-anchor="middle" font-weight="600">Distributed</text>
    <text x="200" y="140" font-family="'Inter', sans-serif" font-size="20" fill="#FF9900" text-anchor="middle" font-weight="600">Cache System</text>
    <text x="200" y="170" font-family="'Inter', sans-serif" font-size="16" fill="#E0E0E0" text-anchor="middle">Sub-ms Response Time</text>
    <text x="200" y="200" font-family="'Inter', sans-serif" font-size="14" fill="#B0B0B0" text-anchor="middle">70% DB Load Reduction • 99.99% Hit Rate</text>
    <g transform="translate(200, 260)">
        <rect x="-30" y="-10" width="60" height="20" fill="#00E676" opacity="0.2" rx="4"/>
        <text x="0" y="5" font-family="'Inter', sans-serif" font-size="12" fill="#00E676" text-anchor="middle">View Demo</text>
    </g>
    <!-- Sample cache cluster visualization -->
    <g transform="translate(100, 150)">
        <!-- Node 1 -->
        <circle cx="0" cy="0" r="20" fill="#FF9900" opacity="0.3" stroke="#FF9900" stroke-width="2"/>
        <text x="0" y="5" font-family="'Inter', sans-serif" font-size="12" fill="#FF9900" text-anchor="middle">Node 1</text>
        <!-- Node 2 -->
        <circle cx="50" cy="-30" r="20" fill="#00E676" opacity="0.3" stroke="#00E676" stroke-width="2"/>
        <text x="50" y="-25" font-family="'Inter', sans-serif" font-size="12" fill="#00E676" text-anchor="middle">Node 2</text>
        <!-- Node 3 -->
        <circle cx="50" cy="30" r="20" fill="#FF9900" opacity="0.3" stroke="#FF9900" stroke-width="2"/>
        <text x="50" y="35" font-family="'Inter', sans-serif" font-size="12" fill="#FF9900" text-anchor="middle">Node 3</text>
        <!-- Node 4 -->
        <circle cx="-50" cy="30" r="20" fill="#00E676" opacity="0.3" stroke="#00E676" stroke-width="2"/>
        <text x="-50" y="35" font-family="'Inter', sans-serif" font-size="12" fill="#00E676" text-anchor="middle">Node 4</text>
        <!-- Node 5 -->
        <circle cx="-50" cy="-30" r="20" fill="#FF9900" opacity="0.3" stroke="#FF9900" stroke-width="2"/>
        <text x="-50" y="-25" font-family="'Inter', sans-serif" font-size="12" fill="#FF9900" text-anchor="middle">Node 5</text>
        <!-- Connections -->
        <line x1="0" y1="0" x2="50" y2="-30" stroke="#E0E0E0" stroke-width="1.5" opacity="0.5"/>
        <line x1="0" y1="0" x2="50" y2="30" stroke="#E0E0E0" stroke-width="1.5" opacity="0.5"/>
        <line x1="0" y1="0" x2="-50" y2="-30" stroke="#E0E0E0" stroke-width="1.5" opacity="0.5"/>
        <line x1="0" y1="0" x2="-50" y2="30" stroke="#E0E0E0" stroke-width="1.5" opacity="0.5"/>
        <line x1="50" y1="-30" x2="50" y2="30" stroke="#E0E0E0" stroke-width="1.5" opacity="0.5"/>
        <line x1="-50" y1="-30" x2="-50" y2="30" stroke="#E0E0E0" stroke-width="1.5" opacity="0.5"/>
    </g>
</svg>