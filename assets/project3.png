<svg width="400" height="300" viewBox="0 0 400 300" xmlns="http://www.w3.org/2000/svg">
    <defs>
        <linearGradient id="proj3Grad" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" style="stop-color:#FF9900;stop-opacity:0.8" />
            <stop offset="100%" style="stop-color:#00E676;stop-opacity:0.8" />
        </linearGradient>
    </defs>
    <rect width="400" height="300" fill="url(#proj3Grad)" />
    <rect x="20" y="20" width="360" height="260" fill="#0D0D0D" opacity="0.9" rx="8" ry="8"/>
    <text x="200" y="110" font-family="'Inter', sans-serif" font-size="20" fill="#FF9900" text-anchor="middle" font-weight="600">Serverless</text>
    <text x="200" y="140" font-family="'Inter', sans-serif" font-size="20" fill="#00E676" text-anchor="middle" font-weight="600">Data Pipeline</text>
    <text x="200" y="170" font-family="'Inter', sans-serif" font-size="16" fill="#E0E0E0" text-anchor="middle">TB+ Daily Processing</text>
    <text x="200" y="200" font-family="'Inter', sans-serif" font-size="14" fill="#B0B0B0" text-anchor="middle">90% Faster • Zero Server Mgmt</text>
    <g transform="translate(200, 260)">
        <rect x="-30" y="-10" width="60" height="20" fill="#FF9900" opacity="0.2" rx="4"/>
        <text x="0" y="5" font-family="'Inter', sans-serif" font-size="12" fill="#FF9900" text-anchor="middle">View Demo</text>
    </g>
    <!-- Sample data flow diagram -->
    <g transform="translate(100, 180)">
        <!-- S3 Bucket -->
        <rect x="0" y="0" width="60" height="40" fill="#FF9900" opacity="0.3" stroke="#FF9900" stroke-width="2" rx="4"/>
        <text x="30" y="25" font-family="'Inter', sans-serif" font-size="10" fill="#FF9900" text-anchor="middle">S3</text>
        <!-- Lambda -->
        <rect x="80" y="10" width="60" height="40" fill="#00E676" opacity="0.3" stroke="#00E676" stroke-width="2" rx="4"/>
        <text x="110" y="35" font-family="'Inter', sans-serif" font-size="10" fill="#00E676" text-anchor="middle">Lambda</text>
        <!-- Glue -->
        <rect x="160" y="0" width="60" height="40" fill="#FF9900" opacity="0.3" stroke="#FF9900" stroke-width="2" rx="4"/>
        <text x="190" y="25" font-family="'Inter', sans-serif" font-size="10" fill="#FF9900" text-anchor="middle">Glue</text>
        <!-- Athena -->
        <rect x="240" y="10" width="60" height="40" fill="#00E676" opacity="0.3" stroke="#00E676" stroke-width="2" rx="4"/>
        <text x="270" y="35" font-family="'Inter', sans-serif" font-size="10" fill="#00E676" text-anchor="middle">Athena</text>
        <!-- Arrows -->
        <line x1="60" y1="20" x2="80" y2="30" stroke="#E0E0E0" stroke-width="2" marker-end="url(#arrowhead)"/>
        <line x1="140" y1="20" x2="160" y2="20" stroke="#E0E0E0" stroke-width="2" marker-end="url(#arrowhead)"/>
        <line x1="220" y1="20" x2="240" y2="30" stroke="#E0E0E0" stroke-width="2" marker-end="url(#arrowhead)"/>
        <defs>
            <marker id="arrowhead" markerWidth="10" markerHeight="7" refX="0" refY="3.5" orient="auto">
                <polygon points="0 0, 10 3.5, 0 7" fill="#E0E0E0"/>
            </marker>
        </defs>
    </g>
</svg>